PORT=3000
CORS_ORIGIN=http://localhost:5173

# memory | postgres | mysql | mongodb | neo4j
DB_DRIVER=memory

# Used only by the matching driver (values match scripts/db.sh defaults)
POSTGRES_URL=postgresql://lab:lab@localhost:5432/lab
MYSQL_URL=mysql://lab:lab@localhost:3306/lab
MONGO_URL=mongodb://lab:lab@localhost:27017/lab?authSource=admin
NEO4J_URL=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=labpassword

# TypeORM (postgres/mysql): auto-create tables from entities (dev only)
DB_SYNC=true
DB_LOGGING=false
